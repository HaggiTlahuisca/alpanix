{
	"appId": "com.tlahuis.alpanix",
	"appName": "Alpanix",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"alert",
				"sound",
				"badge"
			]
		}
	}
}
